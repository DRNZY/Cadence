{
  "name": "cadence",
  "productName": "Cadence",
  "version": "1.0.0",
  "description": "A beautiful local-first music player for Linux — Apple glass meets Material 3.",
  "type": "module",
  "main": "dist-electron/main.js",
  "author": "Darnell",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:linux": "npm run build && electron-builder --linux AppImage tar.gz",
    "build:win": "npm run build && electron-builder --win portable nsis",
    "build:all": "npm run build && electron-builder --linux AppImage tar.gz --win portable nsis",
    "start": "electron ."
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "motion": "^12.0.0-alpha.2",
    "music-metadata": "^10.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.0.6",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
