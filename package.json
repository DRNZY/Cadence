{
  "name": "cadence",
  "productName": "Cadence",
  "version": "2.0.0",
  "description": "High-Fidelity Studio Audio Player & Synced Karaoke Lyrics Engine",
  "author": "Darnell",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT,APP\" -c \"magenta,cyan,green\" \"tsx server/index.ts\" \"vite\" \"electron electron/main.cjs\"",
    "build:client": "tsc -b && vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --outfile=dist-server/index.mjs --packages=external",
    "build": "npm run build:client && npm run build:server",
    "build:all": "npm run build && electron-builder -l -w -m",
    "build:linux": "npm run build && electron-builder --linux AppImage tar.gz deb",
    "build:win": "npm run build && electron-builder --win nsis zip",
    "build:mac": "npm run build && electron-builder --mac zip",
    "start": "electron electron/main.cjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "dev:client": "vite",
    "dev:server": "tsx server/index.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
