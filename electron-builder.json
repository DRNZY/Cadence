{
  "appId": "com.darnell.cadence",
  "productName": "Cadence",
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "dist/**/*",
    "dist-server/**/*",
    "electron/**/*",
    "package.json"
  ],
  "asar": true,
  "linux": {
    "target": [
      "AppImage",
      "tar.gz"
    ],
    "icon": "packaging/cadence.png",
    "category": "Audio",
    "mimeTypes": [
      "audio/flac",
      "audio/mpeg",
      "audio/x-wav",
      "audio/mp4",
      "audio/ogg",
      "audio/opus",
      "audio/aac"
    ]
  }
}
