{
  "appId": "io.github.drnzy.cadence",
  "productName": "Cadence",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-server/**/*",
    "electron/**/*",
    "package.json"
  ],
  "asar": true,
  "linux": {
    "target": [
      "AppImage",
      "tar.gz",
      "deb",
      "snap"
    ],
    "category": "AudioVideo",
    "maintainer": "DRNZY <darnell.dijksteel@gmail.com>",
    "synopsis": "Studio Hi-Fi Linux Audio Engine",
    "icon": "packaging/cadence.png",
    "mimeTypes": [
      "audio/flac",
      "audio/mpeg",
      "audio/x-wav",
      "audio/mp4",
      "audio/ogg",
      "audio/opus",
      "audio/aac"
    ]
  },
  "snap": {
    "grade": "stable",
    "confinement": "strict",
    "plugs": [
      "default",
      "audio-playback",
      "pulseaudio",
      "home",
      "removable-media",
      "network",
      "network-bind",
      "opengl",
      "wayland",
      "x11"
    ]
  },
  "win": {
    "target": [
      "nsis",
      "zip"
    ],
    "icon": "public/icon.ico"
  },
  "mac": {
    "target": [
      "zip"
    ],
    "icon": "packaging/cadence.png",
    "category": "public.app-category.music"
  }
}
