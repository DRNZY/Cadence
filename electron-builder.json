{
  "appId": "com.darnell.cadence",
  "productName": "Cadence",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-server/**/*",
    "electron/**/*",
    "package.json"
  ],
  "asar": true,
  "linux": {
    "target": [
      "AppImage",
      "tar.gz",
      "deb"
    ],
    "maintainer": "Darnell <darnell.dijksteel@gmail.com>",
    "icon": "packaging/cadence.png",
    "category": "Audio",
    "mimeTypes": [
      "audio/flac",
      "audio/mpeg",
      "audio/x-wav",
      "audio/mp4",
      "audio/ogg",
      "audio/opus",
      "audio/aac"
    ]
  },
  "win": {
    "target": [
      "nsis",
      "zip"
    ],
    "icon": "public/icon.ico"
  },
  "mac": {
    "target": [
      "zip"
    ],
    "icon": "packaging/cadence.png",
    "category": "public.app-category.music"
  }
}
